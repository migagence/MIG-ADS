---
/**
 * Seconde landing page : /cro (« LP CRO MIG »).
 * Même ossature et mêmes composants que la page d’accueil, textes propres
 * (src/data/cro.ts). La page d’accueil n’est pas modifiée : les deux tournent en parallèle.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import VideoTestimonials from '../components/VideoTestimonials.astro';
import CaseAccordion from '../components/CaseAccordion.astro';
import MigMethod from '../components/MigMethod.astro';
import Objections from '../components/Objections.astro';
import FinalCTA from '../components/FinalCTA.astro';
import BookingSection from '../components/BookingSection.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { booking } from '../data/site';
import {
  croMeta,
  croHero,
  croHeroKpis,
  croVideo,
  croVideoTestimonials,
  croCasesHeading,
  croCaseStudies,
  croMethodHeading,
  croMethodSteps,
  croFaq,
  croClosing,
  croBooking,
  croDiagnosticSteps,
  croCtaLabels,
} from '../data/cro';

const ctaNote = `${booking.microcopy} · ${booking.durationMinutes} min`;
---
<Base title={croMeta.title} description={croMeta.description} path={croMeta.path} noindex={croMeta.noindex}>
  <Header ctaLabel={croCtaLabels.header} ctaShort={croCtaLabels.headerShort} />
  <main id="main">
    <Hero
      pill={croHero.pill}
      title={croHero.title}
      lead={croHero.lead}
      leadShort={croHero.leadShort}
      ctaLabel={croHero.ctaLabel}
      ctaSub={croHero.ctaSub}
      ctaNote={ctaNote}
      chip={croHero.chip}
      kpis={croHeroKpis}
      video={croVideo}
    />
    <VideoTestimonials items={croVideoTestimonials} />
    <CaseAccordion
      title={croCasesHeading.title}
      lead={croCasesHeading.lead}
      items={croCaseStudies}
      ctaLabel={croCasesHeading.ctaLabel}
    />
    <MigMethod
      eyebrow={croMethodHeading.eyebrow}
      title={croMethodHeading.title}
      lead={croMethodHeading.lead}
      steps={croMethodSteps}
      pipelineEnd={croMethodHeading.pipelineEnd}
    />
    <Objections items={croFaq} />
    <FinalCTA
      eyebrow={croClosing.eyebrow}
      title={croClosing.title}
      lead={croClosing.lead}
      ctaLabel={croClosing.ctaLabel}
      ctaSub={croClosing.ctaSub}
      steps={croClosing.steps}
      notFor={croClosing.notFor}
    />
    <BookingSection
      title={croBooking.title}
      lead={croBooking.lead}
      steps={croDiagnosticSteps}
      pageTag={croMeta.bookingTag}
    />
  </main>
  <Footer />
  <StickyCta label={croCtaLabels.sticky} />
  <ConsentBanner />
</Base>
