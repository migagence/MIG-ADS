---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import VideoTestimonials from '../components/VideoTestimonials.astro';
import CaseAccordion from '../components/CaseAccordion.astro';
import MigMethod from '../components/MigMethod.astro';
import Objections from '../components/Objections.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import BookingModal from '../components/BookingModal.astro';
import StickyCta from '../components/StickyCta.astro';
---
<Base>
  <Header />
  <main id="main">
    <Hero />
    <VideoTestimonials />
    <CaseAccordion />
    <MigMethod />
    <Objections />
    <FinalCTA />
  </main>
  <Footer />
  <BookingModal />
  <StickyCta />
</Base>
