---
import { Image } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import logoNavy from '../assets/logos/mig-logo-navy.png';
import logoWhite from '../assets/logos/mig-logo-white.png';
import { nav } from '../data/site';
interface Props { solid?: boolean }
const { solid = false } = Astro.props;
---
<header class:list={['site-header', solid && 'is-solid']} data-header>
  <div class="container site-header__inner">
    <a href="#top" class="site-header__logo" aria-label="MIG, retour en haut de page">
      <Image src={logoWhite} alt="MIG" height={26} width={61} densities={[1, 2, 3]} format="png" loading="eager" decoding="sync" class="logo logo--light" />
      <Image src={logoNavy} alt="" height={26} width={61} densities={[1, 2, 3]} format="png" loading="eager" decoding="sync" class="logo logo--dark" aria-hidden="true" />
    </a>
    <nav class="site-header__nav" aria-label="Navigation principale">
      {nav.map((item) => <a href={item.href} data-track="nav_click">{item.label}</a>)}
    </nav>
    <div class="site-header__cta">
      <CtaButton size="sm" label="Réserver mon diagnostic" short="Réserver" track="header_cta_click" />
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 50; color: #fff;
    background: transparent; border-bottom: 1px solid transparent;
    transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .site-header.is-scrolled, .site-header.is-solid {
    color: var(--c-ink); background: rgba(252, 252, 252, 0.9); border-bottom-color: var(--c-border);
    -webkit-backdrop-filter: saturate(160%) blur(12px); backdrop-filter: saturate(160%) blur(12px);
  }
  .site-header__inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; height: var(--header-h); }
  .site-header__logo { display: inline-flex; align-items: center; min-height: 44px; justify-self: start; }
  .site-header__logo img { height: 26px; width: auto; }
  .logo--dark { display: none; }
  .is-scrolled .logo--dark, .is-solid .logo--dark { display: block; }
  .is-scrolled .logo--light, .is-solid .logo--light { display: none; }
  .site-header__nav { display: none; }
  .site-header__nav a { font-weight: 500; color: rgba(255, 255, 255, 0.78); padding: 0.5rem 0.25rem; transition: color var(--dur) var(--ease); }
  .site-header__nav a:hover { color: #fff; }
  .is-scrolled .site-header__nav a, .is-solid .site-header__nav a { color: var(--c-ink-2); }
  .is-scrolled .site-header__nav a:hover, .is-solid .site-header__nav a:hover { color: var(--c-ink); }
  .site-header__cta { justify-self: end; }
  .site-header:not(.is-scrolled):not(.is-solid) :global(.btn--primary) { box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18); }
  @media (min-width: 900px) { .site-header__nav { display: flex; gap: 2.25rem; justify-self: center; } }
  @media (max-width: 899px) { .site-header__inner { grid-template-columns: 1fr auto; } }
  @media (max-width: 640px) { .site-header { --header-h: 64px; } .site-header__logo img { height: 22px; } }
</style>
