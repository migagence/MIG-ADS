---
import CtaButton from './CtaButton.astro';
import Icon from './Icon.astro';
import TrustpilotStars from './TrustpilotStars.astro';
import { booking, trust } from '../data/site';
import { notFitFor } from '../data/fit';
---
<section class="section closing" id="diagnostic" aria-labelledby="closing-title" data-closing>
  <div class="container closing__grid">
    <div class="closing__copy">
      <p class="eyebrow eyebrow--light reveal">Diagnostic gratuit · {booking.durationMinutes} min</p>
      <h2 class="h2 closing__title reveal" id="closing-title" data-delay="1">Tu n’as probablement pas besoin de dépenser plus.<br />Tu as besoin de savoir où ton système perd de l’argent.</h2>
      <p class="lead closing__lead reveal" data-delay="2">{booking.durationMinutes} minutes pour identifier tes blocages et tes actions prioritaires.</p>
      <div class="closing__cta reveal" data-delay="3">
        <CtaButton abLabel size="lg" track="final_cta_click" onDark block />
        <p class="microcopy closing__micro">{booking.microcopy}</p>
      </div>
      <ul class="closing__trust reveal" data-delay="4">
        <li><TrustpilotStars size={16} /><span><strong>{trust.rating}/5</strong> sur Trustpilot</span></li>
        <li><span><strong>{trust.brandsCount}</strong> marques accompagnées</span></li>
      </ul>
    </div>

    <div class="closing__panel reveal" data-delay="2">
      <h3 class="closing__panel-title">Comment ça se passe</h3>
      <ol class="dsteps">
        <li><span class="dsteps__idx num" aria-hidden="true">1</span><span><strong>Tu choisis ton créneau</strong><span class="dsteps__text">Directement sur le calendrier ci-dessous.</span></span></li>
        <li><span class="dsteps__idx num" aria-hidden="true">2</span><span><strong>On prépare ton diagnostic</strong><span class="dsteps__text">On regarde ton site, tes campagnes et tes flows avant l’appel.</span></span></li>
        <li><span class="dsteps__idx num" aria-hidden="true">3</span><span><strong>On débriefe ensemble</strong><span class="dsteps__text">Tu repars avec tes blocages et tes actions prioritaires.</span></span></li>
      </ol>
      <p class="closing__not">Pas pour toi si {notFitFor[2].replace(/\.$/, '')}.</p>
    </div>
  </div>
</section>
<style>
  .closing { position: relative; background: var(--c-night); color: #fff; overflow: hidden; }
  .closing::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(60% 70% at 15% 100%, rgba(8, 73, 250, 0.3), transparent 70%); }
  .closing__grid { position: relative; display: grid; gap: 2.5rem; align-items: center; }
  .closing__copy { display: grid; gap: 1.25rem; max-width: 620px; }
  .closing__title { color: #fff; }
  .closing__lead { color: var(--c-night-ink); }
  .closing__cta { display: grid; gap: 0.6rem; margin-top: 0.5rem; }
  .closing__micro { color: var(--c-night-ink); text-align: center; }
  .closing__trust { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; font-size: 0.9375rem; color: var(--c-night-ink); }
  .closing__trust li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .closing__trust strong { color: #fff; }
  .closing__panel { background: #fff; color: var(--c-ink); border-radius: var(--r-lg); padding: clamp(1.25rem, 3vw, 2rem); display: grid; gap: 1rem; box-shadow: var(--shadow-3); }
  .closing__panel-title { font-size: 0.8125rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-ink-3); font-weight: 600; }
  .dsteps { display: grid; gap: 0.7rem; }
  .dsteps li { display: grid; grid-template-columns: 28px 1fr; gap: 0.75rem; align-items: start; }
  .dsteps li > span:last-child { display: grid; gap: 0.1rem; }
  .dsteps__idx { width: 28px; height: 28px; border-radius: 8px; background: var(--c-blue); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 0.8125rem; }
  .dsteps strong { font-weight: 600; }
  .dsteps__text { font-size: 0.875rem; color: var(--c-ink-2); }
  .closing__not { font-size: 0.8125rem; color: var(--c-ink-3); border-top: 1px solid var(--c-border); padding-top: 0.9rem; }
  @media (min-width: 1024px) {
    .closing__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 4rem; }
    .closing__micro { text-align: left; }
  }
  @media (max-width: 480px) { .closing__cta { width: 100%; } }
</style>
