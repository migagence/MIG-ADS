---
/** 4,7/5 → Trustpilot affiche 4 étoiles pleines et une demi-étoile (arrondi Trustpilot). */
interface Props { size?: number; class?: string }
const { size = 20, class: className } = Astro.props;
const stars = [1, 1, 1, 1, 0.5];
const uid = Math.random().toString(36).slice(2, 8);
---
<span class:list={['tp-stars', className]} role="img" aria-label="Note 4,7 sur 5 sur Trustpilot" style={`--s:${size}px`}>
  {stars.map((fill, i) => (
    <svg viewBox="0 0 40 40" width={size} height={size} aria-hidden="true" focusable="false">
      {fill < 1 && (
        <defs>
          <clipPath id={`tp-${uid}-${i}`}><rect width={40 * fill} height="40" /></clipPath>
        </defs>
      )}
      <rect width="40" height="40" rx="4" fill="#d5dbe6" />
      <rect width="40" height="40" rx="4" fill="var(--c-tp)" clip-path={fill < 1 ? `url(#tp-${uid}-${i})` : undefined} />
      <path d="M20 27.35 26.08 25.72 28.63 34 20 27.35ZM34 16.65H23.29L20 6l-3.29 10.65H6l8.67 6.6-3.3 10.66 8.67-6.6 5.33-4.05L34 16.65Z" fill="#fff" />
    </svg>
  ))}
</span>
<style>
  .tp-stars { display: inline-flex; gap: calc(var(--s) * 0.12); flex: none; }
</style>
