---
import Icon from './Icon.astro';
import TrustpilotStars from './TrustpilotStars.astro';
import { booking, trust } from '../data/site';
---
<dialog class="booking" id="booking" aria-labelledby="booking-title">
  <div class="booking__panel">
    <header class="booking__head">
      <div class="booking__intro">
        <h2 class="booking__title" id="booking-title">Réserver mon diagnostic gratuit</h2>
        <p class="booking__meta">
          <span>{booking.microcopy} · {booking.durationMinutes} min</span>
          <span class="booking__tp"><TrustpilotStars size={14} /> {trust.rating}/5 sur Trustpilot</span>
        </p>
      </div>
      <button type="button" class="booking__close" data-booking-close aria-label="Fermer la prise de rendez-vous"><Icon name="close" size={20} /></button>
    </header>
    <div class="booking__body">
      <div class="booking__status" data-booking-status data-state="loading" aria-live="polite">
        <span class="booking__spinner" aria-hidden="true"></span>
        <p data-msg="loading">Chargement du calendrier…</p>
        <p data-msg="slow">Le calendrier met du temps à charger.</p>
        <p data-msg="error">Le calendrier n’a pas pu être chargé.</p>
        <p data-msg="booked">Créneau confirmé. À très vite.</p>
        <a class="btn btn--secondary btn--sm" data-booking-fallback href={booking.calendlyUrl} target="_blank" rel="noopener">Ouvrir Calendly dans un nouvel onglet <Icon name="external" size={15} /></a>
      </div>
      <div class="booking__calendly" data-calendly-host data-url={booking.calendlyUrl}></div>
    </div>
  </div>
</dialog>
<style>
  .booking { border: 0; padding: 0; margin: 0; background: transparent; max-width: none; max-height: none; width: 100vw; height: 100dvh; inset: 0; }
  .booking::backdrop { background: rgba(3, 5, 26, 0.65); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }
  .booking[open] { display: grid; place-items: center; }
  .booking__panel {
    width: min(100% - 2rem, 1040px); height: min(100dvh - 2rem, 920px);
    background: #fff; border-radius: var(--r-xl); display: flex; flex-direction: column; overflow: hidden; box-shadow: var(--shadow-3);
    animation: booking-in 0.28s var(--ease);
  }
  @keyframes booking-in { from { opacity: 0; transform: translateY(12px) scale(0.985); } to { opacity: 1; transform: none; } }
  .booking__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.25rem; border-bottom: 1px solid var(--c-border); }
  .booking__title { font-size: 1.125rem; font-weight: 700; letter-spacing: -0.02em; }
  .booking__meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; font-size: 0.8125rem; color: var(--c-ink-3); margin-top: 0.2rem; }
  .booking__tp { display: inline-flex; align-items: center; gap: 0.35rem; }
  .booking__close { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; color: var(--c-ink-2); border: 1px solid var(--c-border); flex: none; transition: background var(--dur) var(--ease); }
  .booking__close:hover { background: var(--c-surface-2); color: var(--c-ink); }
  .booking__body { position: relative; flex: 1; min-height: 0; overflow: auto; -webkit-overflow-scrolling: touch; background: var(--c-surface-2); }
  .booking__calendly { min-height: 100%; height: 100%; }
  .booking__calendly :global(iframe) { display: block; }
  .booking__status { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 0.75rem; text-align: center; padding: 1.5rem; color: var(--c-ink-2); pointer-events: none; }
  .booking__status[data-state='ready'] { display: none; }
  .booking__status[data-state='loading'] p:not([data-msg='loading']),
  .booking__status[data-state='slow'] p:not([data-msg='slow']),
  .booking__status[data-state='error'] p:not([data-msg='error']),
  .booking__status[data-state='booked'] p:not([data-msg='booked']) { display: none; }
  .booking__status[data-state='booked'] { pointer-events: none; display: none; }
  .booking__status[data-state='error'] .booking__spinner { display: none; }
  .booking__status[data-state='loading'] [data-booking-fallback] { visibility: hidden; }
  .booking__status [data-booking-fallback] { pointer-events: auto; }
  .booking__spinner { width: 28px; height: 28px; border-radius: 50%; border: 3px solid var(--c-tint-2); border-top-color: var(--c-blue); animation: spin 0.9s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (max-width: 640px) {
    .booking__panel { width: 100%; height: 100dvh; border-radius: 0; animation-name: booking-in-mobile; }
    @keyframes booking-in-mobile { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
    .booking__meta .booking__tp { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .booking__panel { animation: none; } .booking__spinner { animation-duration: 2s; } }
</style>
